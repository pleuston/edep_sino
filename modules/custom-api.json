{
    "openapi": "3.0.3",
    "info": {
        "version": "1.0.0",
        "title": "epiwen – Custom API",
        "description": "This is the place to add your own path endpoints"
    },
    "servers": [
        {
            "description": "Endpoint for testing on localhost",
            "url": "/exist/apps/epiwen"
        }
    ],
    "components": {
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "name": "teipublisher.com.login",
                "in": "cookie"
            }
        }
    },
    "tags": [],
    "paths": {
        "/api/editor/places": {
            "get": {
                "summary": "List places",
                "description": "Retrieve list of places in format required by pb-split-list",
                "operationId": "eapi:places-browse",
                "parameters": [
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 50
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Categories and places to display",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "update/add places",
                "x-constraints": {
                    "group": [
                        "tei"
                    ]
                },
                "operationId": "eapi:places-add",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "places-add",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/editor/places/{id}": {
            "get": {
                "summary": "show place",
                "operationId": "eapi:load-place",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "places-list",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "update/add place",
                "x-constraints": {
                    "group": "tei"
                },
                "operationId": "eapi:places-add",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "places-add",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/editor/places/{id}/findSpot": {
            "get": {
                "summary": "Retrieve the find spot of an inscription",
                "description": "Retrieve a place in format required by pb-split-list",
                "operationId": "eapi:find-spot",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Categories and places to display",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "categories": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "category": {
                                                        "type": "string"
                                                    },
                                                    "count": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/geopicker/places": {
            "get": {
                "summary": "shortlist of places for geodata-picker page",
                "operationId": "eapi:geopicker-places",
                "responses": {
                    "200": {
                        "description": "places-list for geo picker page",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/editor/people": {
            "get": {
                "summary": "List people",
