                    {
                        "name": "id",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "collection",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "get template",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "update/add inscription",
                "x-constraints": {
                    "group": "tei"
                },
                "operationId": "eapi:inscription",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "collection",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "inscription",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/fragment": {
            "post": {
                "summary": "update/add fragment",
                "x-constraints": {
                    "group": "tei"
                },
                "operationId": "eapi:fragment",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "collection",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "fragment",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/render": {
            "post": {
                "summary": "Render the transcription",
                "operationId": "eapi:render",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "rendered transcription",
                        "content": {
                            "text/html": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/document/{id}/epidoc": {
            "get": {
                "summary": "Get the Epidoc source of a document",
                "description": "Get the source of a document, either as XML, text or binary.",
                "tags": [
                    "documents"
                ],
                "operationId": "eapi:epidoc",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Content of the document",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "text/markdown": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "text/text": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "410": {
                        "description": "Document deleted"
                    }
                }
            }
        },
        "/api/zotero/sync": {
            "get": {
                "summary": "Incrementally sync local cache.",
                "tags": [
                    "zotero"
                ],
                "operationId": "zotero:sync",
                "responses": {
                    "200": {
                        "description": "Sync result.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "304": {
                        "description": "No updates."
                    }
                }
            }
        },
        "/api/zotero/items/suggest": {
            "get": {
                "security": [
                    {
                        "basicAuth": []
                    }
                ],
                "summary": "Lightweight suggestions for autocomplete (key, tag, label HTML).",
                "tags": [
                    "zotero"
                ],
                "operationId": "zotero:items-suggest",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "tag",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer",
                            "default": 8
                        }
                    },
                    {
                        "in": "query",
                        "name": "top",
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Suggestion list",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/zotero/items/search": {
            "get": {
                "security": [
                    {
                        "basicAuth": []
                    }
                ],
                "summary": "Search cached items. JSON only.",
                "tags": [
                    "zotero"
                ],
                "operationId": "zotero:items-search",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string",
                            "default": "Ama"
                        },
                        "description": "Full-text over title/creators/DOI."
                    },
                    {
                        "in": "query",
                        "name": "tag",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Restrict to items having this tag."
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of items (key + data).",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sino/era": {
            "get": {
                "summary": "Convert a Chinese era date (nianhao + reign year) to ISO dates",
                "description": "Looks the era up in the nianhao authority (DDBC-derived). Returns all candidate eras with proleptic-Gregorian when/notBefore/notAfter for the given reign year and a ganzhi consistency check.",
                "tags": [
                    "sino"
                ],
                "operationId": "sino-dates:era",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Era name (nianhao), e.g. 永和"
                    },
                    {
                        "name": "year",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Reign year (1-based)"
                    },
                    {
                        "name": "ganzhi",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Cyclical year for consistency check, e.g. 癸丑"
                    },
                    {
                        "name": "dynasty",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Dynasty name to disambiguate, e.g. 東晉"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Candidate eras with conversions",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sino/eras": {
            "get": {
                "summary": "Full era (nianhao) list for autocomplete",
                "tags": [
                    "sino"
                ],
                "operationId": "sino-dates:eras",
                "responses": {
                    "200": {
                        "description": "All eras with dynasty and span",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sino/chronology": {
            "get": {
                "summary": "Chronology data for the timeline renderer",
                "description": "Dynasty bands, person lifespans and work dates for the 年表 timeline. Filters: from/to (ISO year), dynasty (taxonomy key), type (persons|works|both).",
                "tags": [
                    "sino"
                ],
                "operationId": "eapi:jinshi-chronology",
                "parameters": [
                    {
                        "name": "from",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "dynasty",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "both"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Chronology data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sites": {
            "get": {
                "summary": "Sites (find-spots) with their inscriptions",
                "description": "Place entity files joined with the inscriptions whose origPlace points at them; sorted by holdings.",
                "tags": [
                    "sino"
                ],
                "operationId": "eapi:sites",
                "responses": {
                    "200": {
                        "description": "Site list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "security": [
        {
            "cookieAuth": []
        },
        {
            "basicAuth": []
        }
    ]
}