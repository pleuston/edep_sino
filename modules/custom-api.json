                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Categories and people to display",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "update/add person",
                "x-constraints": {
                    "group": "tei"
                },
                "operationId": "eapi:person-add",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "places-add",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/editor/people/{id}": {
            "get": {
                "summary": "show person",
                "operationId": "eapi:load-person",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "person record",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "update/add person",
                "x-constraints": {
                    "group": "tei"
                },
                "operationId": "eapi:person-add",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "places-add",
                        "content": {
                            "application/xml": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/inscription": {
            "get": {
                "summary": "get template",
                "operationId": "eapi:inscription-template",
