            <div xml:lang="zh">
                <p>
                    <lb n="01"/>
                    <name corresp="en-a1" key="bg0004" reg="Sakyamuni" type="Buddha" xml:id="zh-a1">佛</name>告<persName corresp="en-a2" key="rh0003" reg="Prasenajit" type="emperor" xml:id="zh-a2">波斯<choice>
